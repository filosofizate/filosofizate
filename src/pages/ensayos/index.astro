---
const ensayos = [
  {
    numero: "01",
    titulo: "De la deuda, de la reciprocidad y de sus tensiones",
    descripcion:
      "Una exploración de la deuda como relación temporal, moral y política.",
    temas: ["Deuda", "Reciprocidad", "Justicia"],
    enlace: "/ensayos/de-la-deuda-de-la-reciprocidad-y-de-sus-tensiones",
  },
  {
    numero: "02",
    titulo: "Del colapso de la información",
    descripcion:
      "Una reflexión sobre la aceleración informativa y los límites humanos para procesarla.",
    temas: ["Información", "Tecnología", "Sociedad"],
    enlace: "/ensayos/colapso-informacion",
  },
  {
    numero: "03",
    titulo: "De lo aparentemente inevitable: la propiedad",
    descripcion:
      "Una reconsideración de la propiedad como relación histórica, temporal y social.",
    temas: ["Propiedad", "Tiempo", "Lo común"],
    enlace: "/ensayos/propiedad",
  },
  {
  numero: "04",
  titulo: "De lo soberano, de lo subyacente, de lo desigual",
  descripcion:
    "Una exploración de la relación entre soberanía, subordinación y desigualdad social.",
  temas: ["Soberanía", "Desigualdad", "Poder"],
  enlace: "/ensayos/soberania",
  },
  {
    numero: "05",
    titulo: "Capital, deuda y crédito: una distinción conceptual",
    descripcion:
      "Una distinción entre capital, deuda y crédito y el modo en que se articulan en las economías contemporáneas.",
    temas: ["Capital", "Deuda", "Crédito"],
    enlace: "/ensayos/capital-deuda-credito",
  },
  {
    numero: "06",
    titulo: "Unidad ontológica social, financiarización y confianza",
    descripcion:
      "Una reconsideración del sujeto histórico de transformación en el capitalismo financiarizado.",
    temas: ["Confianza", "Financiarización", "Sujeto histórico"],
    enlace: "/ensayos/confianza-financiarizacion",
  },
  {
    numero: "07",
    titulo: "Del crédito, del visado y del crédito del visado",
    descripcion:
      "Una reflexión sobre el pasaporte, la movilidad y la distribución desigual del crédito institucional.",
    temas: ["Crédito", "Visado", "Movilidad"],
    enlace: "/ensayos/credito-visado",
  },
  {
    numero: "08",
    titulo: "El mito del incentivo y la colonización capitalista de la motivación",
    descripcion:
      "Una crítica de la identificación entre motivación humana e incentivo económico capitalista.",
    temas: ["Incentivo", "Motivación", "Capitalismo"],
    enlace: "/ensayos/incentivo-capitalista",
  },
  {
    numero: "09",
    titulo: "Del premio, del agasajo y de la aceptación",
    descripcion:
      "Una indagación sobre el premio, el reconocimiento y las relaciones sociales que hacen posible su aceptación.",
    temas: ["Premio", "Reconocimiento", "Reciprocidad"],
    enlace: "/ensayos/premio-agasajo",
  },
  {
    numero: "10",
    titulo: "De lo propio, de lo común y de su igualdad",
    descripcion:
      "Una reflexión sobre las escalas desde las que distinguimos lo propio, lo común y sus relaciones de igualdad.",
    temas: ["Propiedad", "Lo común", "Igualdad"],
    enlace: "/ensayos/propio-comun",
  },
  {
    numero: "11",
    titulo: "Del salario y del crédito sin interés",
    descripcion:
      "Una reconsideración del salario como forma cotidiana de crédito concedido sin interés.",
    temas: ["Salario", "Crédito", "Interés"],
    enlace: "/ensayos/salario-credito",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="FilosofíZate: ensayos filosóficos para pensar de nuevo los conceptos con los que vivimos."
    />

    <title>FilosofíZate</title>
  </head>

  <body>
    <header class="cabecera">
      <a class="marca" href="/">
        Filosofí<span>Zate</span>
      </a>

      <nav aria-label="Navegación principal">
        <a href="#ensayos">Ensayos</a>
        <a href="#conceptos">Conceptos</a>
        <a href="#proyecto">Proyecto</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-superior">
          <p class="sobrelinea">Filosofía en construcción</p>

          <p class="edicion">
            Cuaderno abierto
            <br />
            2026
          </p>
        </div>

        <h1>
          Pensar de nuevo
          <br />
          los conceptos
          <br />
          con los que vivimos.
        </h1>

        <div class="hero-inferior">
          <p class="introduccion">
            Ensayos sobre deuda, confianza, propiedad, soberanía, información
            y las formas de lo común.
          </p>

          <a class="boton" href="#ensayos">
            Explorar los ensayos
            <span aria-hidden="true">↘</span>
          </a>
        </div>
      </section>

      <section class="franja" aria-label="Conceptos principales">
        <span>Deuda</span>
        <span>Confianza</span>
        <span>Propiedad</span>
        <span>Soberanía</span>
        <span>Información</span>
        <span>Reciprocidad</span>
      </section>

      <section class="seccion ensayos" id="ensayos">
        <header class="cabecera-seccion">
          <div>
            <p class="sobrelinea">Archivo abierto</p>
            <h2>Ensayos recientes</h2>
          </div>

          <p class="nota-seccion">
            Textos provisionales, argumentos en desarrollo y preguntas abiertas
            a la crítica.
          </p>
        </header>

        <div class="lista-ensayos">
          {
            ensayos.map((ensayo) => (
              <article class="ensayo">
                <p class="numero">{ensayo.numero}</p>

                <div class="ensayo-contenido">
                  <div class="temas">
                    {ensayo.temas.map((tema) => <span>{tema}</span>)}
                  </div>

                  <h3>
                    <a href={ensayo.enlace}>
                      {ensayo.titulo}
                    </a>
                  </h3>

                  <p class="descripcion">{ensayo.descripcion}</p>
                </div>

                <a
                  class="flecha"
                  href={ensayo.enlace}
                  aria-label={`Leer ${ensayo.titulo}`}
                >
                  ↗
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section class="seccion manifiesto" id="conceptos">
        <div class="columna-etiqueta">
          <p class="sobrelinea">Método</p>
        </div>

        <div class="columna-principal">
          <h2>
            No una colección de opiniones, sino una arquitectura conceptual.
          </h2>

          <p>
            Cada texto parte de un concepto cotidiano y examina las relaciones,
            presupuestos y tensiones que suelen permanecer ocultos bajo su uso
            ordinario.
          </p>

          <div class="principios">
            <article>
              <span>01</span>
              <h3>Volver al concepto</h3>
              <p>
                Revisar las palabras antes de aceptar como inevitables las
                instituciones que nombran.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>Reducir supuestos</h3>
              <p>
                Buscar estructuras simples capaces de explicar fenómenos
                sociales aparentemente separados.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Abrir la argumentación</h3>
              <p>
                Exponer las ideas a objeciones, referencias y contraejemplos.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="seccion proyecto" id="proyecto">
        <div>
          <p class="sobrelinea">El proyecto</p>

          <h2>Una investigación filosófica desarrollada en público.</h2>
        </div>

        <div class="texto-proyecto">
          <p>
            FilosofíZate acompaña una investigación doctoral y reúne ensayos
            que forman parte de un mismo universo conceptual.
          </p>

          <p>
            La web no presenta conclusiones cerradas. Funciona como un espacio
            de elaboración, contraste y conversación.
          </p>

          <a href="mailto:filosofizate@gmail.com">
            Proponer una objeción o una referencia
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <a class="marca-pie" href="/">FilosofíZate</a>

      <div>
        <p>Ensayos filosóficos en construcción.</p>
        <p>© {new Date().getFullYear()} Vicente Domínguez Arca</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    --fondo: #eee9df;
    --tinta: #171917;
    --suave: rgba(23, 25, 23, 0.62);
    --linea: rgba(23, 25, 23, 0.2);
    --acento: #9f3f25;

    margin: 0;
    background: var(--fondo);
    color: var(--tinta);
    font-family:
      Arial, Helvetica, system-ui, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
  }

  .cabecera,
  main,
  footer {
    width: min(1240px, calc(100% - 48px));
    margin: 0 auto;
  }

  .cabecera {
    min-height: 88px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--linea);
  }

  .marca,
  .marca-pie {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.55rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.03em;
  }

  .marca span {
    color: var(--acento);
  }

  nav {
    display: flex;
    gap: 34px;
  }

  nav a {
    position: relative;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.11em;
  }

  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -7px;
    height: 1px;
    background: var(--tinta);
    transition: right 180ms ease;
  }

  nav a:hover::after {
    right: 0;
  }

  .hero {
    min-height: calc(100vh - 88px);
    padding: 44px 0 58px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom: 1px solid var(--linea);
  }

  .hero-superior,
  .hero-inferior {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .sobrelinea,
  .edicion {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.17em;
  }

  .edicion {
    text-align: right;
    color: var(--suave);
  }

  h1,
  h2,
  h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
    line-height: 1.02;
  }

  h1 {
    max-width: 1120px;
    margin: 55px 0;
    font-size: clamp(4.3rem, 10vw, 9.2rem);
    letter-spacing: -0.065em;
  }

  .ensayo h3 a {
    color: inherit;
    text-decoration: none;
  }

  .ensayo h3 a:hover {
    text-decoration: underline;
  }

  .ensayo h3 a:active {
   opacity: 0.75;
  }

  .introduccion {
    max-width: 620px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.42;
  }

  .boton {
    min-width: 235px;
    padding: 15px 18px;
    display: flex;
    justify-content: space-between;
    border: 1px solid var(--tinta);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .boton:hover {
    background: var(--tinta);
    color: var(--fondo);
  }

  .franja {
    width: 100%;
    padding: 17px max(24px, calc((100% - 1240px) / 2));
    display: flex;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
    background: var(--tinta);
    color: var(--fondo);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    font-style: italic;
    white-space: nowrap;
  }

  .franja span:not(:last-child)::after {
    content: "·";
    margin-left: clamp(30px, 5vw, 80px);
    color: var(--acento);
  }

  .seccion {
    padding: 110px 0;
    border-bottom: 1px solid var(--linea);
  }

  .cabecera-seccion {
    margin-bottom: 68px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 60px;
    align-items: end;
  }

  h2 {
    margin: 18px 0 0;
    font-size: clamp(3rem, 6vw, 6rem);
    letter-spacing: -0.05em;
  }

  .nota-seccion {
    max-width: 420px;
    margin: 0 0 10px;
    color: var(--suave);
  }

  .ensayo {
    position: relative;
    min-height: 280px;
    padding: 42px 0;
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) 80px;
    gap: 30px;
    border-top: 1px solid var(--linea);
    transition: padding 180ms ease;
  }

  .ensayo:last-child {
    border-bottom: 1px solid var(--linea);
  }

  .ensayo:hover {
    padding-left: 18px;
  }

  .numero {
    margin: 5px 0 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.8rem;
    color: var(--acento);
  }

  .temas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .temas span {
    padding: 4px 8px;
    border: 1px solid var(--linea);
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ensayo h3 {
    max-width: 920px;
    margin: 30px 0 20px;
    font-size: clamp(2.3rem, 5vw, 4.7rem);
    letter-spacing: -0.045em;
  }

  .descripcion {
    max-width: 680px;
    margin: 0;
    color: var(--suave);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.13rem;
  }

  .flecha {
    width: 58px;
    height: 58px;
    align-self: center;
    justify-self: end;
    display: grid;
    place-items: center;
    border: 1px solid var(--tinta);
    border-radius: 50%;
    font-size: 1.45rem;
    text-decoration: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .flecha:hover {
    background: var(--tinta);
    color: var(--fondo);
    transform: rotate(45deg);
  }

  .manifiesto {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 70px;
  }

  .columna-principal > p {
    max-width: 760px;
    margin: 42px 0 70px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.35rem;
  }

  .principios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .principios article {
    min-height: 265px;
    padding: 24px;
    border: 1px solid var(--linea);
  }

  .principios span {
    color: var(--acento);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
  }

  .principios h3 {
    margin: 58px 0 17px;
    font-size: 1.65rem;
  }

  .principios p {
    margin: 0;
    color: var(--suave);
    font-size: 0.93rem;
  }

  .proyecto {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 100px;
  }

  .texto-proyecto {
    padding-top: 45px;
  }

  .texto-proyecto p {
    margin: 0 0 24px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
  }

  .texto-proyecto a {
    display: inline-flex;
    gap: 20px;
    margin-top: 25px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--tinta);
    font-size: 0.77rem;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  footer {
    padding: 50px 0 70px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  footer div {
    text-align: right;
    color: var(--suave);
    font-size: 0.78rem;
  }

  footer p {
    margin: 0 0 5px;
  }

  @media (max-width: 850px) {
    .cabecera {
      align-items: flex-start;
      padding: 24px 0;
    }

    nav {
      flex-direction: column;
      gap: 4px;
      text-align: right;
    }

    .hero {
      min-height: auto;
      padding: 50px 0 70px;
    }

    .hero-inferior,
    .cabecera-seccion,
    .manifiesto,
    .proyecto {
      display: block;
    }

    .hero-inferior .boton {
      margin-top: 38px;
    }

    .franja {
      justify-content: flex-start;
    }

    .nota-seccion {
      margin-top: 30px;
    }

    .ensayo {
      grid-template-columns: 55px minmax(0, 1fr);
    }

    .flecha {
      display: none;
    }

    .principios {
      grid-template-columns: 1fr;
    }

    .principios article {
      min-height: auto;
    }

    .texto-proyecto {
      padding-top: 40px;
    }
  }

  @media (max-width: 560px) {
    .cabecera,
    main,
    footer {
      width: min(100% - 30px, 1240px);
    }

    h1 {
      font-size: clamp(3.5rem, 18vw, 5.8rem);
    }

    .hero-superior {
      display: block;
    }

    .edicion {
      margin-top: 20px;
      text-align: left;
    }

    .seccion {
      padding: 80px 0;
    }

    .ensayo {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .numero {
      margin-bottom: 12px;
    }

    footer {
      flex-direction: column;
      gap: 30px;
    }

    footer div {
      text-align: left;
    }
  }
</style>