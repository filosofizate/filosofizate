---
export const prerender = false;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <title>Moderación del foro | FilosofíZate</title>
  <style>
    :root { font-family: system-ui, sans-serif; color-scheme: light; background: #f7f6f2; color: #252525; }
    * { box-sizing: border-box; }
    body { margin: 0; }
    main { max-width: 900px; margin: 0 auto; padding: 36px 18px 70px; }
    h1 { font-family: Georgia, serif; font-size: clamp(1.9rem, 5vw, 2.7rem); margin: 0 0 10px; }
    h2 { font-family: Georgia, serif; margin-top: 32px; }
    p { line-height: 1.65; }
    .sub { color: #565656; }
    .panel, article { background: white; border: 1px solid #ddd8cc; border-radius: 12px; padding: 22px; margin-top: 18px; }
    label { display: block; font-weight: 600; margin-bottom: 8px; }
    input { width: 100%; padding: 12px; font: inherit; border: 1px solid #aaa; border-radius: 7px; }
    button { cursor: pointer; font: inherit; padding: 10px 15px; border-radius: 7px; border: 1px solid #49463e; background: #292820; color: white; }
    button.secondary { background: white; color: #292820; }
    button.danger { background: #8c3030; border-color: #8c3030; }
    button:disabled { opacity: .55; cursor: wait; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
    .meta { color: #666; font-size: .9rem; overflow-wrap: anywhere; }
    .body { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.65; }
    .status { min-height: 1.5em; }
    .error { color: #a11e1e; }
    .empty { color: #555; font-style: italic; }
    a { color: #51472b; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <main>
    <p><a href="/foro/">← Volver al foro</a></p>
    <h1>Moderación del foro</h1>
    <p class="sub">Aquí gestiono las conversaciones y respuestas pendientes, publicadas y retiradas.</p>
    <section class="panel" aria-label="Acceso a la moderación">
      <form id="acceso">
        <label for="token">Clave ADMIN_TOKEN</label>
        <input id="token" type="password" autocomplete="off" required spellcheck="false" />
        <div class="actions"><button type="submit">Entrar en administración</button><button class="secondary" type="button" id="salir">Cerrar sesión de esta pestaña</button></div>
      </form>
      <p id="estado" class="status" role="status" aria-live="polite"></p>
    </section>
    <section id="resultados" hidden>
      <div class="actions" role="group" aria-label="Filtrar intervenciones">
        <button type="button" data-filtro="pendiente" aria-pressed="true">Pendientes</button>
        <button type="button" data-filtro="publicado" aria-pressed="false">Publicadas</button>
        <button type="button" data-filtro="rechazado" aria-pressed="false">Rechazadas o retiradas</button>
        <button class="secondary" id="actualizar" type="button">Actualizar</button>
      </div>
      <h2 id="seccion-actual">Pendientes</h2>
      <h2>Conversaciones <span id="num-conversaciones"></span></h2>
      <div id="conversaciones"></div>
      <h2>Respuestas <span id="num-mensajes"></span></h2>
      <div id="mensajes"></div>
    </section>
  </main>
  <script is:inline>
    (() => {
      const $ = id => document.getElementById(id);
      let token = '';
      let estadoActual = 'pendiente';
      const estado = (texto, error = false) => {
        $('estado').textContent = texto;
        $('estado').classList.toggle('error', error);
      };
      function nodo(tag, clase, texto) {
        const el = document.createElement(tag);
        if (clase) el.className = clase;
        if (texto !== undefined) el.textContent = String(texto);
        return el;
      }
      async function peticion(url, opciones = {}) {
        const respuesta = await fetch(url, {
          ...opciones,
          cache: 'no-store',
          headers: { Authorization: `Bearer ${token}`, ...(opciones.headers || {}) }
        });
        if (!respuesta.ok) {
          if (respuesta.status === 401) throw new Error('Clave incorrecta o secreto no disponible.');
          const detalle = await respuesta.json().catch(() => ({}));
          throw new Error(detalle.error || `Error ${respuesta.status}`);
        }
        return respuesta.json();
      }
      async function actuar(tipo, item, accion) {
        if (accion === 'eliminar') {
          const aviso = tipo === 'conversacion'
            ? 'Eliminar DEFINITIVAMENTE esta conversación y TODAS sus respuestas. No se podrá recuperar.'
            : 'Eliminar DEFINITIVAMENTE esta respuesta. No se podrá recuperar.';
          if (!confirm(aviso)) return;
          const confirmacion = prompt('Escribe ELIMINAR para confirmar la eliminación irreversible:');
          if (confirmacion !== 'ELIMINAR') return;
        } else if (accion === 'retirar' && !confirm('¿Retirar esta intervención de la vista pública? Podrás volver a publicarla.')) return;
        estado('Guardando cambios…');
        try {
          await peticion('/api/foro/moderacion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ tipo, id: Number(item.id), accion })
          });
          await cargar();
          estado('Cambio guardado correctamente.');
        } catch (error) { estado(error.message, true); }
      }
      function mostrar(lista, destino, tipo) {
        destino.replaceChildren();
        if (!Array.isArray(lista) || !lista.length) {
          destino.append(nodo('p', 'empty', 'No hay intervenciones en esta sección.'));
          return;
        }
        for (const item of lista) {
          const articulo = nodo('article');
          articulo.append(nodo('h3', '', item.titulo || `Respuesta a la conversación ${item.conversacion_id}`));
          articulo.append(nodo('p', 'meta', `ID ${item.id} · ${item.autor || 'Anónimo'} · ${item.creada || ''}`));
          if (tipo === 'conversacion') articulo.append(nodo('p', 'meta', `Espacio: ${item.espacio}${item.tema ? ' · Tema: ' + item.tema : ''}`));
          articulo.append(nodo('p', 'body', item.contenido || ''));
          const acciones = nodo('div', 'actions');
          const opciones = estadoActual === 'pendiente'
            ? [['publicar', 'Aprobar', ''], ['rechazar', 'Rechazar', 'secondary']]
            : estadoActual === 'publicado'
              ? [['retirar', 'Retirar de publicación', 'secondary'], ['eliminar', 'Eliminar definitivamente', 'danger']]
              : [['publicar', 'Volver a publicar', ''], ['eliminar', 'Eliminar definitivamente', 'danger']];
          for (const [accion, etiqueta, clase] of opciones) {
            const boton = nodo('button', clase, etiqueta);
            boton.type = 'button';
            boton.addEventListener('click', () => actuar(tipo, item, accion));
            acciones.append(boton);
          }
          articulo.append(acciones);
          destino.append(articulo);
        }
      }
      async function cargar() {
        const datos = await peticion(`/api/foro/moderacion?estado=${encodeURIComponent(estadoActual)}`);
        $('resultados').hidden = false;
        $('num-conversaciones').textContent = `(${datos.conversaciones.length})`;
        $('num-mensajes').textContent = `(${datos.mensajes.length})`;
        mostrar(datos.conversaciones, $('conversaciones'), 'conversacion');
        mostrar(datos.mensajes, $('mensajes'), 'mensaje');
        $('seccion-actual').textContent = estadoActual === 'pendiente' ? 'Pendientes' : estadoActual === 'publicado' ? 'Publicadas' : 'Rechazadas o retiradas';
      }
      $('acceso').addEventListener('submit', async event => {
        event.preventDefault();
        token = $('token').value;
        $('token').value = '';
        try { await cargar(); estado('Acceso autorizado.'); }
        catch (error) { token = ''; $('resultados').hidden = true; estado(error.message, true); }
      });
      $('actualizar').addEventListener('click', async () => {
        try { await cargar(); estado('Lista actualizada.'); } catch (error) { estado(error.message, true); }
      });
      $('salir').addEventListener('click', () => {
        token = '';
        $('token').value = '';
        $('resultados').hidden = true;
        $('conversaciones').replaceChildren();
        $('mensajes').replaceChildren();
        estado('Acceso cerrado en esta pestaña.');
      });
      document.querySelectorAll('[data-filtro]').forEach(boton => {
        boton.addEventListener('click', async () => {
          estadoActual = boton.dataset.filtro;
          document.querySelectorAll('[data-filtro]').forEach(b => b.setAttribute('aria-pressed', String(b === boton)));
          try { await cargar(); estado(''); } catch (error) { estado(error.message, true); }
        });
      });
    })();
  </script>
</body>
</html>
