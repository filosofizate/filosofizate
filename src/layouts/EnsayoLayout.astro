---
interface Props {
  titulo: string;
  descripcion: string;
  fecha: Date;
  autor: string;
  conceptos: string[];
}

const {
  titulo,
  descripcion,
  fecha,
  autor,
  conceptos,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={descripcion} />

    <title>{titulo} | FilosofíZate</title>
  </head>

  <body>
    <header class="cabecera">
      <a class="marca" href="/">FilosofíZate</a>

      <nav>
        <a href="/">Inicio</a>
        <a href="/ensayos">Ensayos</a>
      </nav>
    </header>

    <main>
      <article>
        <header class="encabezado">
          <a class="volver" href="/ensayos">
            ← Volver a los ensayos
          </a>

          <div class="conceptos">
            {
              conceptos.map((concepto) => (
                <span>{concepto}</span>
              ))
            }
          </div>

          <h1>{titulo}</h1>

          <p class="descripcion">{descripcion}</p>

          <p class="metadatos">
            {autor}
            <span> · </span>
            <time datetime={fecha.toISOString()}>
              {fecha.toLocaleDateString("es-ES", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </time>
          </p>
        </header>

        <div class="contenido">
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #eee9df;
    color: #171917;
    font-family: Georgia, "Times New Roman", serif;
    line-height: 1.75;
  }

  .cabecera {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
    padding: 25px 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgba(23, 25, 23, 0.2);
  }

  .marca {
    font-size: 1.5rem;
    font-weight: bold;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a,
  .volver {
    color: inherit;
  }

  main {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
  }

  article {
    padding: 70px 0 120px;
  }

  .encabezado {
    max-width: 900px;
    margin-bottom: 70px;
  }

  .volver {
    display: inline-block;
    margin-bottom: 50px;
  }

  .conceptos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .conceptos span {
    padding: 4px 9px;
    border: 1px solid rgba(23, 25, 23, 0.25);
    font-family: Arial, sans-serif;
    font-size: 0.7rem;
    text-transform: uppercase;
  }

  h1 {
    margin: 28px 0;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: normal;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .descripcion {
    max-width: 750px;
    font-size: 1.35rem;
    color: rgba(23, 25, 23, 0.7);
  }

  .metadatos {
    margin-top: 30px;
    font-family: Arial, sans-serif;
    font-size: 0.8rem;
  }

  .contenido {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.15rem;
  }

  .contenido :global(h2) {
    margin-top: 3.5rem;
    font-size: 2.2rem;
    line-height: 1.15;
  }

  .contenido :global(h3) {
    margin-top: 2.5rem;
    font-size: 1.6rem;
  }

  .contenido :global(p) {
    margin: 0 0 1.5rem;
  }

  .contenido :global(blockquote) {
    margin: 2.5rem 0;
    padding-left: 25px;
    border-left: 2px solid #9f3f25;
    font-style: italic;
  }

  .contenido :global(a) {
    color: #8c351f;
  }
</style>