---
const { titulo, descripcion = 'Conversación filosófica abierta en FilosofíZate' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={descripcion}/><link rel="icon" href="/iconopng.png"/><title>{titulo} · FilosofíZate</title></head><body>
<header><a class="marca" href="/">Filosofí<span>Zate</span></a><nav><a href="/">Ensayos</a><a href="/foro/">Foro</a><a href="/licencia/">Lo común</a></nav></header>
<main><slot /></main><footer><a href="/">FilosofíZate</a><p>Filosofía en construcción · <a href="/licencia/">CC BY-SA 4.0 para los textos del autor</a></p></footer>
</body></html>
<style is:global>
*{box-sizing:border-box}html{scroll-behavior:smooth}body{--fondo:#eee9df;--tinta:#171917;--suave:#696a65;--linea:#c5c0b6;--acento:#9f3f25;background:var(--fondo);color:var(--tinta);margin:0;font:16px/1.65 Arial,Helvetica,sans-serif}a{color:inherit}header,main,footer{width:min(1100px,calc(100% - 40px));margin:auto}header{display:flex;justify-content:space-between;gap:25px;align-items:center;border-bottom:1px solid var(--linea);padding:24px 0}header nav{display:flex;gap:24px;flex-wrap:wrap;font-size:.8rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em}header a{text-decoration:none}.marca{font:700 1.6rem Georgia,serif}.marca span{color:var(--acento)}main{padding:64px 0 100px;min-height:65vh}h1,h2,h3{font-family:Georgia,serif;font-weight:400;line-height:1.12}h1{font-size:clamp(3rem,7vw,6rem);letter-spacing:-.055em;margin:10px 0 25px}h2{font-size:clamp(2rem,4vw,3rem)}h3{font-size:1.65rem}.kicker{font-size:.72rem;text-transform:uppercase;letter-spacing:.15em;font-weight:700;color:var(--acento)}.intro{font:1.3rem/1.5 Georgia,serif;max-width:760px}.muted{color:var(--suave)}.linea{border-top:1px solid var(--linea);padding:25px 0}.tarjeta{border:1px solid var(--linea);padding:26px;margin:16px 0}.tarjeta h3{margin:8px 0}.tarjeta a{text-decoration:none}.tarjeta a:hover{text-decoration:underline}.etiquetas{display:flex;gap:8px;flex-wrap:wrap}.etiqueta{border:1px solid var(--linea);padding:5px 10px;text-decoration:none;font-size:.77rem}.boton,button{display:inline-block;background:transparent;color:var(--tinta);border:1px solid var(--tinta);padding:13px 20px;text-decoration:none;font:700 .76rem Arial;letter-spacing:.08em;text-transform:uppercase;cursor:pointer}.boton:hover,button:hover{background:var(--tinta);color:var(--fondo)}.formulario{border-top:1px solid var(--linea);padding-top:25px;margin-top:40px;max-width:720px}.formulario label{display:block;margin-top:18px;font-weight:700;font-size:.85rem}.formulario input:not([type=checkbox]),.formulario textarea{width:100%;background:transparent;border:1px solid var(--linea);padding:12px;color:var(--tinta);font:inherit}.formulario textarea{min-height:140px}.formulario .aceptacion{display:flex;gap:10px;align-items:flex-start;font-weight:400}.formulario button{margin-top:20px}.mensaje{white-space:pre-wrap;overflow-wrap:anywhere}.respuesta{border-top:1px solid var(--linea);padding:20px 0}footer{border-top:1px solid var(--linea);padding:35px 0 60px;display:flex;justify-content:space-between;gap:20px;font-size:.85rem}@media(max-width:600px){header,footer{flex-direction:column;align-items:flex-start}main{padding-top:35px}}
</style>
